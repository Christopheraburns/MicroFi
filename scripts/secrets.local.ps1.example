# scripts/secrets.local.ps1.example
#
# Template for the MicroFi dev-loop scripts. To use:
#   1. Copy this file to scripts/secrets.local.ps1
#   2. Fill in the values for your EFM host and SSH credentials.
#   3. secrets.local.ps1 is gitignored; this .example file is committed.

$EfmHost     = "<your-efm-host-or-ip>"
$SshUser     = "<your-ssh-user>"
$SshPassword = "<your-ssh-password>"

# Derived — leave as-is unless your EFM uses a non-default port.
# Note: ${EfmHost} braces are required so PowerShell doesn't parse $EfmHost:
# as a scope/drive reference inside the double-quoted URL.
$EfmBaseUrl  = "http://${EfmHost}:10090/efm/api"