# scripts/secrets.local.sh.example
#
# Template for the MicroFi dev-loop shell scripts. To use:
#   1. Copy this file to scripts/secrets.local.sh
#   2. Fill in the values for your EFM host and SSH credentials.
#   3. secrets.local.sh is gitignored; this .example file is committed.
#
# This file is sourced by the bash scripts, so it must be valid bash.

# Hostname or IP of the machine running EFM. Used both as the SSH target
# (for stopping/starting EFM, wiping the H2 DB) and as the host portion of
# the EFM REST API URL.
EFM_HOST="<your-efm-host-or-ip>"

# SSH user on $EFM_HOST. Must have permission to run the EFM start/stop
# scripts and delete files under ~/efm/database/.
SSH_USER="<your-ssh-user>"

# SSH password for $SSH_USER. Used via sshpass. If you'd rather use
# key-based auth, leave this empty and modify the consuming scripts to
# drop the `sshpass -e` prefix.
SSH_PASSWORD="<your-ssh-password>"

# Derived — leave as-is unless your EFM uses a non-default port.
EFM_BASE_URL="http://${EFM_HOST}:10090/efm/api"

# Path to the PlatformIO CLI on this machine. Most installs put it at
# ~/.platformio/penv/bin/pio (Linux/macOS). If `pio` is on your PATH you
# can leave the literal string "pio" here.
PIO_EXE="${HOME}/.platformio/penv/bin/pio"
