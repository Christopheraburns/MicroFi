# MicroFi ESP-IDF default configuration
#
# These are the values that ship with the repo. Tweaks should go through
# menuconfig (`pio run -t menuconfig` or `idf.py menuconfig`) and end up
# here so they survive across clean builds.

# --- MicroFi configuration ---------------------------------------------------
# Mirrors the Kconfig.projbuild options in src/. The WiFi and C2 values are
# placeholders -- override them for your environment before flashing, either
# by editing this file or via `pio run -t menuconfig` -> "MicroFi configuration".

CONFIG_MICROFI_WIFI_SSID="<your-wifi-ssid>"
CONFIG_MICROFI_WIFI_PASSWORD=""
CONFIG_MICROFI_C2_HEARTBEAT_URL="http://172.28.82.242:10090/efm/api/c2-protocol/heartbeat"
CONFIG_MICROFI_C2_ACK_URL="http://172.28.82.242:10090/efm/api/c2-protocol/acknowledge"
CONFIG_MICROFI_AGENT_CLASS="default"
CONFIG_MICROFI_AGENT_ID=""
CONFIG_MICROFI_HEARTBEAT_INTERVAL_MS=30000

# --- MicroFi storage ---------------------------------------------------------
# Defaults match the "30-day offline durability" target on the 16 MB Lonely
# Binary S3 with the partitions.csv shipped in the repo. Watermarks are
# tuned to keep LittleFS in the predictable-performance band; adjust via
# menuconfig if you want a different durability vs. performance trade.

CONFIG_MICROFI_LITTLEFS_PARTITION_LABEL="littlefs"
CONFIG_MICROFI_LITTLEFS_FORMAT_ON_MOUNT_FAIL=y
CONFIG_MICROFI_LITTLEFS_HIGH_WATER_PCT=80
CONFIG_MICROFI_LITTLEFS_LOW_WATER_PCT=70
CONFIG_MICROFI_SD_OVERFLOW=n
CONFIG_MICROFI_RETENTION_DROP_OLDEST=y
CONFIG_MICROFI_EVICTION_BATCH_HINT=0
CONFIG_MICROFI_STORAGE_METRICS=y

# --- esp_littlefs component --------------------------------------------------
# Enable the upstream esp_littlefs IDF component. Without this the storage
# subsystem can't mount.
CONFIG_LITTLEFS_EN