# Per-device overlay for physical unit #2 (XIAO ESP32-S3 Sense,
# MAC 14:c1:9f:42:19:24) -- EFM agent class MicroFi-2.
# Applied last in the SDKCONFIG_DEFAULTS chain, so these override
# sdkconfig.defaults' MicroFi/microfi_1 values.
#
# NOTE the sdkconfig.defaults.* naming: PlatformIO writes each env's
# GENERATED full config to sdkconfig.<env-name> in the project root, so an
# overlay must never be named sdkconfig.microfi2 -- the build clobbers it
# and, seeing an existing sdkconfig, ignores the defaults chain entirely
# (first microfi2 build came out with 2MB flash size that way).
#
# Agent id is left blank on purpose: agent_id.h derives
# "microfi-<mac-hex>" from the eFuse MAC, unique per physical unit by
# construction -- no fixed-id reuse across devices.
CONFIG_MICROFI_AGENT_CLASS="MicroFi-2"
CONFIG_MICROFI_AGENT_ID=""
